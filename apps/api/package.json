{
  "name": "@mame/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "tsx src/migrate.ts",
    "setup-code": "tsx src/setup-code.ts",
    "recovery-code": "tsx src/admin-recovery-code.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.18",
    "@better-auth/prisma-adapter": "1.7.18",
    "@hono/node-server": "2.1.6",
    "@mame/contracts": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": { "@types/pg": "8.23.1", "prisma": "7.10.1" }
}

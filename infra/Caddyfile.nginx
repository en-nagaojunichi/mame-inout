{
    admin off
    auto_https off
}

:8080 {
    @api path /api /api/*
    handle @api {
        reverse_proxy api:3001 {
            # ホストのNginxが上書きする値だけを転送する。公開ポートはloopbackに限定する。
            header_up X-Mame-Client-IP {http.request.header.X-Mame-Client-IP}
        }
    }
    handle {
        reverse_proxy web:3000
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        # QR受付のカメラは同じサイトだけに許可し、音声・位置情報は許可しない。
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    }
}

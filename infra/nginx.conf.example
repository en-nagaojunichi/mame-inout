# ホスト名・証明書パス・内部ポートを設置先に合わせる。
server {
    listen 80;
    server_name mame.example.com;
    return 308 https://mame.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name mame.example.com;
    ssl_certificate /etc/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/ssl/example/private.key;
    # 表示画像の更新用。認証・業務APIにはHonoで従来の32KiB上限を適用する。
    client_max_body_size 192k;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # 外部から同名ヘッダーを送られても、信頼した接続元情報で上書きする。
        proxy_set_header X-Mame-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_cache off;
    }
}

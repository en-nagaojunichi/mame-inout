{
  "name": "mame-inout",
  "version": "0.1.0-dev.m08",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "generate": "npm run generate -w @mame/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests scripts --max-warnings 0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --configLoader native",
    "test:e2e": "playwright test",
    "build": "npm run build -w @mame/contracts && npm run build -w @mame/api && npm run build -w @mame/web",
    "dev:setup": "node scripts/setup-dev.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "@next/eslint-plugin-next": "16.4.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
